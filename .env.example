# career-ops environment variables
# Copy to .env for local development: cp .env.example .env

# ── Autonomous Agent (agent/loop.mjs) ─────────────────────────────────────────
# Required for daily GitHub Actions scan + email digest

# Gemini API key (free tier: 1500 req/day)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Resend email (free tier: 3000 emails/month)
# Get one at: https://resend.com/api-keys
RESEND_API_KEY=

# Email addresses for digest
DIGEST_TO=shubhivashistha08@gmail.com
DIGEST_FROM=digest@yourdomain.com   # must be a verified sender in Resend
                                    # for testing, use: onboarding@resend.dev

# Dry run mode (skip email + pipeline writes, log to console only)
# DRY_RUN=true

# ── PDF Generation (generate-pdf.mjs) ────────────────────────────────────────
# No additional env vars needed — uses Playwright (already a dependency)
